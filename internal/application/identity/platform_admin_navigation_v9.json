{
  "contract_version": "domainry-admin-navigation-workspaces-v9",
  "source_owner": "domainry-identity",
  "policy": "task-oriented workspaces group related production routes; backend modules are ownership boundaries, not sidebar items",
  "admission_policy": {
    "sidebar_represents": "user_task_workspace",
    "default_destination": "existing_workspace_local_tab_detail_flow_or_command_search",
    "count_policy": "derived_from_primary_business_tasks_no_fixed_maximum",
    "forbidden_drivers": [
      "backend_module",
      "capability_key",
      "resource_type",
      "production_route"
    ],
    "required_evidence": [
      "cannot_fit_existing_workspace",
      "independent_permission_boundary",
      "frequent_direct_access",
      "restricted_access_test"
    ]
  },
