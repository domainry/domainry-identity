{
  "name": "identity-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Domainry Identity administration console.",
  "domainry": {
    "artifact_kind": "platform_admin",
    "allowed_surfaces": [
      "admin_console"
    ]
  },
  "scripts": {
    "dev": "vite --port 3100",
    "build": "npm --prefix .. run brand:check && npm run routes:check && tsc -b && vite build",
    "routes:export": "node scripts/export-route-registry.mjs",
    "routes:check": "node scripts/export-route-registry.mjs --check",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-table": "^8.21.3",
    "@domainry/surface-contract": "file:../packages/surface-contract",
    "@domainry/ui": "file:../packages/ui",
    "@domainry/identity-client": "file:../../../domainry-identity-sdk/browser",
    "@domainry/identity-management-contract": "file:../packages/management-contract",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.8",
    "vitest": "^3.2.7"
  }
}
